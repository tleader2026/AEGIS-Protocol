{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aegis.dev/runtime-signature.schema.json",
  "title": "RuntimeSignature",
  "type": "object",
  "required": ["runtimeId", "envelopeDigest", "imageDigest", "policyDigest", "attestation", "signature"],
  "properties": {
    "runtimeId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
    "envelopeDigest": { "$ref": "./defs.schema.json#/$defs/digest" },
    "imageDigest": { "$ref": "./defs.schema.json#/$defs/digest" },
    "policyDigest": { "$ref": "./defs.schema.json#/$defs/digest" },
    "attestation": { "type": "string" },
    "signature": { "$ref": "./defs.schema.json#/$defs/coseOrDetachedSignature" }
  },
  "additionalProperties": false
}
