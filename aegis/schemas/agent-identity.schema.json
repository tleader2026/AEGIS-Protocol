{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aegis.dev/agent-identity.schema.json",
  "title": "AgentIdentity",
  "type": "object",
  "required": ["did", "namespace", "controller", "keyRefs"],
  "properties": {
    "did": { "$ref": "./defs.schema.json#/$defs/did" },
    "namespace": { "$ref": "./defs.schema.json#/$defs/aegisNamespace" },
    "controller": { "type": "string", "minLength": 3 },
    "keyRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "attestationRefs": { "type": "array", "items": { "type": "string" } },
    "delegation": { "type": "string" }
  },
  "additionalProperties": false
}
