{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aegis.dev/provenance-block.schema.json",
  "title": "ProvenanceBlock",
  "type": "object",
  "required": ["blockId", "parentIds", "eventType", "actor", "artifactDigest", "timestamp", "signature"],
  "properties": {
    "blockId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
    "parentIds": { "type": "array", "items": { "$ref": "./defs.schema.json#/$defs/aegisUri" } },
    "eventType": { "type": "string" },
    "actor": { "type": "string" },
    "artifactDigest": { "$ref": "./defs.schema.json#/$defs/digest" },
    "semanticRefs": { "type": "array", "items": { "type": "string" } },
    "timestamp": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "./defs.schema.json#/$defs/coseOrDetachedSignature" }
  },
  "additionalProperties": false
}
