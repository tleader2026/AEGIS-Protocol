{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aegis.dev/execution-envelope.schema.json",
  "title": "ExecutionEnvelope",
  "type": "object",
  "required": ["envelopeId", "agent", "model", "runtime", "steps", "sealedAt"],
  "properties": {
    "envelopeId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
    "agent": { "type": "string", "minLength": 3 },
    "model": {
      "type": "object",
      "required": ["provider", "id", "version"],
      "properties": {
        "provider": { "type": "string" },
        "id": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["imageDigest", "attestation"],
      "properties": {
        "imageDigest": { "$ref": "./defs.schema.json#/$defs/digest" },
        "attestation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "kind", "digest"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["model.call", "tool.call", "human.approval", "policy.check", "state.checkpoint", "external.action"] },
          "scope": { "type": "string" },
          "digest": { "$ref": "./defs.schema.json#/$defs/digest" },
          "token": { "$ref": "./defs.schema.json#/$defs/aegisUri" }
        },
        "additionalProperties": false
      }
    },
    "reasoningDigest": { "$ref": "./defs.schema.json#/$defs/digest" },
    "sealedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
