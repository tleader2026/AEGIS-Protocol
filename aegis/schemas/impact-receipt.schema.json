{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aegis.dev/impact-receipt.schema.json",
  "title": "ImpactReceipt",
  "type": "object",
  "required": ["receiptId", "actions", "systems", "risk", "review"],
  "properties": {
    "receiptId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system", "operation", "digest"],
        "properties": {
          "system": { "type": "string", "minLength": 2 },
          "operation": { "type": "string", "minLength": 2 },
          "digest": { "$ref": "./defs.schema.json#/$defs/digest" },
          "receipt": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "systems": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "risk": {
      "type": "object",
      "required": ["score", "basis"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "basis": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "review": { "enum": ["none", "pending", "approved", "rejected"] },
    "compliance": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
