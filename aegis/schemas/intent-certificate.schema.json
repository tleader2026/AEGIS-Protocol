{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aegis.dev/intent-certificate.schema.json",
  "title": "IntentCertificate",
  "type": "object",
  "required": ["intentId", "issuer", "subject", "goal", "scopes", "autonomy", "expiresAt"],
  "properties": {
    "intentId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
    "issuer": { "type": "string", "minLength": 3 },
    "subject": { "type": "string", "minLength": 3 },
    "goal": { "type": "string", "minLength": 8, "maxLength": 2048 },
    "scopes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.*:-]*$" } },
    "constraints": { "type": "array", "items": { "type": "object" } },
    "autonomy": { "enum": ["human-directed", "supervised", "autonomous"] },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "./defs.schema.json#/$defs/coseOrDetachedSignature" }
  },
  "additionalProperties": false
}
