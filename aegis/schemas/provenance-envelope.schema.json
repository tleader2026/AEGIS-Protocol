{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aegis.dev/provenance-envelope.schema.json",
  "title": "ProvenanceEnvelope",
  "description": "A cross-transport AEGIS record proving accountable agent execution.",
  "type": "object",
  "required": [
    "aegisVersion",
    "envelopeId",
    "transport",
    "session",
    "machine",
    "actor",
    "intent",
    "execution",
    "lineage",
    "issuedAt",
    "signature"
  ],
  "properties": {
    "aegisVersion": { "$ref": "./defs.schema.json#/$defs/aegisVersion" },
    "envelopeId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
    "transport": {
      "type": "object",
      "required": ["kind", "protocolVersion", "conformanceProfile"],
      "properties": {
        "kind": { "enum": ["mcp", "a2a", "acp"] },
        "protocolVersion": { "type": "string", "minLength": 1 },
        "conformanceProfile": {
          "type": "string",
          "pattern": "^AEGIS-(MCP|A2A|ACP)-[0-9]+\\.[0-9]+-draft$"
        },
        "endpoint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": ["sessionId", "startedAt"],
      "properties": {
        "sessionId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
        "startedAt": { "type": "string", "format": "date-time" },
        "parentSessionId": { "$ref": "./defs.schema.json#/$defs/aegisUri" }
      },
      "additionalProperties": false
    },
    "machine": {
      "type": "object",
      "required": ["machineId", "runtimeId"],
      "properties": {
        "machineId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
        "runtimeId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
        "attestationDigest": { "$ref": "./defs.schema.json#/$defs/digest" },
        "regionHint": { "type": "string", "minLength": 2 }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["agentId", "issuer"],
      "properties": {
        "agentId": { "type": "string", "minLength": 3 },
        "issuer": { "type": "string", "minLength": 3 },
        "subject": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "required": ["intentId", "summary", "intentDigest"],
      "properties": {
        "intentId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
        "summary": { "type": "string", "minLength": 1 },
        "intentDigest": { "$ref": "./defs.schema.json#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claimId", "claimType", "occurredAt", "claimDigest"],
            "properties": {
              "claimId": { "$ref": "./defs.schema.json#/$defs/aegisUri" },
              "claimType": {
                "enum": [
                  "session.open",
                  "tool.call",
                  "resource.read",
                  "prompt.render",
                  "agent.message",
                  "agent.delegate",
                  "state.checkpoint",
                  "session.close"
                ]
              },
              "occurredAt": { "type": "string", "format": "date-time" },
              "target": { "type": "string", "minLength": 1 },
              "claimDigest": { "$ref": "./defs.schema.json#/$defs/digest" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": ["parents"],
      "properties": {
        "parents": {
          "type": "array",
          "items": { "$ref": "./defs.schema.json#/$defs/aegisUri" }
        },
        "lineageDigest": { "$ref": "./defs.schema.json#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "jurisdictionHints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["geo_region", "policy_domain", "data_residency", "operator_declared"] },
          "value": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "./defs.schema.json#/$defs/coseOrDetachedSignature" }
  },
  "additionalProperties": false
}
